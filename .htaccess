# Кодировка по умолчанию и защита служебных каталогов
AddDefaultCharset UTF-8
Options -Indexes

DirectoryIndex index.php index.html

# Красивая страница «404»
ErrorDocument 404 /404.php

# Запрет доступа к SQL-дампу и служебным файлам
<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>
